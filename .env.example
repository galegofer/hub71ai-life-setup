# Set these in the BACKEND process environment. They are optional.
# Without them, the assistant uses deterministic plan answers.
OPENAI_API_KEY=
OPENAI_MODEL=
# The frontend development proxy defaults to this address.
BACKEND_URL=http://127.0.0.1:9000
# Local defaults. Railway backend: SERVER_ADDRESS=0.0.0.0 and RAILPACK_JDK_VERSION=25.
SERVER_ADDRESS=127.0.0.1
# Railway backend: set to the exact frontend HTTPS origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Frontend build only: set to the backend HTTPS origin on Railway; leave empty locally.
PUBLIC_API_URL=
